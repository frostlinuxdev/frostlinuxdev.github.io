---
import Default from '@astrojs/starlight/components/Footer.astro';
import { DISCORD_URL } from '../site.config.mjs';
---
{DISCORD_URL && (
	<aside class="discord-cta">
		<div>
			<strong>Need help getting a game running?</strong>
			<span>Join the FrostLinux Discord and ask. People will help you out.</span>
		</div>
		<a href={DISCORD_URL} target="_blank" rel="noopener">Join the Discord</a>
	</aside>
)}
<Default {...Astro.props}><slot /></Default>

<p class="art-credit">
	Game key art and screenshots are © their respective owners and are shown here for identification only.
</p>

<style>
	.discord-cta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-block: 2rem 1rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-accent);
		border-radius: 0.6rem;
		background: var(--sl-color-accent-low);
	}
	.discord-cta div { display: flex; flex-direction: column; gap: 0.15rem; }
	.discord-cta span { color: var(--sl-color-gray-2); font-size: var(--sl-text-sm); }
	.discord-cta a {
		padding: 0.5rem 1rem;
		border-radius: 0.4rem;
		background: var(--sl-color-accent);
		color: var(--sl-color-black);
		font-weight: 600;
		text-decoration: none;
		white-space: nowrap;
	}
	.discord-cta a:hover { background: var(--sl-color-accent-high); }
	.art-credit {
		margin-block: 1.5rem 0;
		text-align: center;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
</style>
